/*
 * Agar mini custom layout. See agar-mini-layout.md for the design.
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include "device_keys.dtsi"

#define BASE 0
#define NUM  1
#define NAV  2
#define FN   3
#define ACC  4

#define SHIFTS (MOD_LSFT|MOD_RSFT)
#define SHORTCUT_MODS (MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT|MOD_LGUI|MOD_RGUI)

// The computer uses xkb `us intl`, where ' " ` ~ ^ are dead keys.
// Plain characters are sent as dead key + Space, accents as dead key + letter.
#define LITERAL(name, key) ZMK_MACRO(name, bindings = <&kp key &kp SPACE>;)
#define DEAD(name, dead, letter) ZMK_MACRO(name, bindings = <&kp dead &kp letter>;)

#define MORPH(name, normal, shifted) \
    name: name { \
        compatible = "zmk,behavior-mod-morph"; \
        #binding-cells = <0>; \
        bindings = <normal>, <shifted>; \
        mods = <SHIFTS>; \
    };

// With Ctrl, Alt or Super active, send `plain` with those mods kept, so the key
// still works as a shortcut (Ctrl+', Super+', ...)
#define UNLESS_SHORTCUT(name, accented, plain) \
    name: name { \
        compatible = "zmk,behavior-mod-morph"; \
        #binding-cells = <0>; \
        bindings = <accented>, <plain>; \
        mods = <SHORTCUT_MODS>; \
        keep-mods = <SHORTCUT_MODS>; \
    };

// Accented vowel for the ACC layer: è, or È when Shift is active
#define ACCENT(v, dead, letter) \
    DEAD(v##_lo, dead, letter) \
    DEAD(v##_up, dead, LS(letter)) \
    MORPH(v, &v##_lo, &v##_up)

&sk {
    release-after-ms = <1500>;
    quick-release;
};

// The accent key: tap it, then the vowel
&sl {
    release-after-ms = <1500>;
};

/ {
    macros {
        LITERAL(lit_apos, SQT)
        LITERAL(lit_dquote, DQT)
        LITERAL(lit_grave, GRAVE)
        LITERAL(lit_tilde, TILDE)
        LITERAL(lit_caret, CARET)
    };

    behaviors {
        ACCENT(acc_a, GRAVE, A)
        ACCENT(acc_e, GRAVE, E)
        ACCENT(acc_i, GRAVE, I)
        ACCENT(acc_o, GRAVE, O)
        ACCENT(acc_u, GRAVE, U)

        // ' key: ' (Shift: "); on ACC: é (Shift: É)
        DEAD(eacute_lo, SQT, E)
        DEAD(eacute_up, SQT, LS(E))
        MORPH(eacute, &eacute_lo, &eacute_up)
        MORPH(quote_mm, &lit_apos, &lit_dquote)
        UNLESS_SHORTCUT(quote, &quote_mm, &kp SQT)

        // NUM layer: ` (Shift: ~) and 6 (Shift: ^) without dead keys
        MORPH(grave_mm, &lit_grave, &lit_tilde)
        MORPH(six_mm, &kp N6, &lit_caret)

        spc_nav: space_nav {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        spc_num: space_num {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        fn_layer {
            if-layers = <NUM NAV>;
            then-layer = <FN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC     &kp Q        &kp W     &kp E       &kp R  &kp T  &kp Y  &kp U       &kp I       &kp O       &kp P      &quote     &kp BSPC
&kp TAB     &kp A        &kp S     &kp D       &kp F  &kp G  &kp H  &kp J       &kp K       &kp L       &kp SEMI   &kp RET
&sl ACC     &kp Z        &kp X     &kp C       &kp V  &kp B  &kp N  &kp M       &kp COMMA   &kp DOT     &kp FSLH   &kp MINUS
            &sk LCTRL    &kp LGUI              &spc_nav NAV SPACE   &spc_num NUM SPACE                  &sk LSHFT  &kp UP
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
&grave_mm  &kp N1    &kp N2  &kp N3    &kp N4    &kp N5     &six_mm     &kp N7    &kp N8    &kp N9    &kp N0     &kp EQUAL  &kp DEL
&trans     &lit_tilde &kp PIPE &kp BSLH &kp LBKT  &kp LBRC   &kp RBRC    &kp RBKT  &kp LPAR  &kp RPAR  &kp UNDER  &trans
&trans     &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &lit_caret  &kp AMPS  &kp STAR  &trans    &trans     &trans
           &trans    &trans                      &trans                 &trans                        &trans     &trans
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
&trans  &trans     &trans     &trans      &trans      &trans  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &trans  &trans  &kp DEL
&trans  &sk LGUI   &sk LALT   &sk LCTRL   &sk LSHFT   &trans  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans  &trans
&trans  &trans     &trans     &trans      &trans      &trans  &trans    &trans     &trans     &trans     &trans  &trans
        &trans     &trans                 &trans                        &trans                           &trans  &trans
            >;
        };

        fn_layer {
            display-name = "Fn";
            bindings = <
&bootloader_reset 0 0  &kp F1           &kp F2           &kp F3           &kp F4       &kp F5        &kp F6      &kp F7        &kp F8        &kp F9      &kp F10   &kp F11  &kp F12
&kp CAPS               &device_bt1 0 0  &device_bt2 0 1  &device_bt3 0 2  &Device_USB  &out OUT_BLE  &kp C_PREV  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT  &kp C_PP  &kp C_MUTE
&trans                 &trans           &trans           &trans           &trans       &trans        &trans      &trans        &trans        &trans      &trans    &trans
                       &trans           &trans                            &trans                     &trans                                  &trans      &trans
            >;
        };

        acc_layer {
            display-name = "Acc";
            bindings = <
&trans      &trans   &trans  &acc_e  &trans  &trans  &trans  &acc_u  &acc_i  &acc_o  &trans  &eacute  &trans
&trans      &acc_a   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&lit_grave  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans   &trans                  &trans                  &trans                  &trans   &trans
            >;
        };

        layer5 { status = "reserved"; };
        layer6 { status = "reserved"; };
        layer7 { status = "reserved"; };
    };
};
